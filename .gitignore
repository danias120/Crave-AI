# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.env

# --- Python & Virtual Environments ---
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
develop-eggs/
eggs/
parts/
var/
sdist/
build/
dist/

# --- Testing & Code Quality ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Node.js / Vite Frontend ---
node_modules/
**/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

